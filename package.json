{
  "name": "the-lantern-room",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "The Lantern Room \u2014 a seated, hands-first WebXR puzzle experience built with Meta's Immersive Web SDK (IWSDK).",
  "license": "MIT",
  "scripts": {
    "dev": "node scripts/dev.mjs --host 0.0.0.0 --port 5173",
    "preview": "vite preview --host 0.0.0.0",
    "build": "vite build",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --config vitest.config.ts",
    "test:watch": "vitest --config vitest.config.ts",
    "dev:plain": "vite --host 0.0.0.0 --port 5173"
  },
  "dependencies": {
    "@iwsdk/core": "1.1.0-rc.2",
    "@pmndrs/uikit": "^1.0.74",
    "@pmndrs/uikit-horizon": "^1.0.74",
    "@pmndrs/uikit-lucide": "^1.0.74",
    "three": "npm:super-three@0.185.0"
  },
  "devDependencies": {
    "@iwsdk/vite-plugin-dev": "1.1.0-rc.2",
    "@types/three": "^0.185.0",
    "typescript": "^5.5.0",
    "vite": "^7.1.4",
    "vitest": "^3.2.4"
  },
  "overrides": {
    "sharp": "0.35.4",
    "three": "npm:super-three@0.185.0"
  },
  "engines": {
    "node": ">=20.19.0 <21.0.0-0 || >=22.12.0 <23.0.0-0 || >=24.0.0"
  }
}
