# Dependencies and local caches (npm cache is kept inside the project so those
# sandboxes that block ~/.npm still work).
node_modules/
.npm-cache/
.chrome-profile/
.chrome-crash/
.pnpm-store/
.pnpm-debug.log*

# Build outputs
dist/
*.tsbuildinfo

# Local dev/runtime state generated by IWSDK, Vite and this project's launcher
.iwsdk/
.dev-ps-shim/
.tmp/
.temp/
pids/
*.pid
*.seed
*.pid.lock

# Environment files
.env
.env.local
.env.production
.env.*.local

# Editor / OS noise
.idea/
.vscode/*
!.vscode/extensions.json
.cursor/
.claude/
.codex/
.agents/
.DS_Store
Thumbs.db
*.swp
*.swo

# Logs and test artifacts
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
coverage/
*.lcov
playwright-report/
test-results/
screenshots/tmp/

# Local MCP / tooling configs
.mcp.json
.cursor/mcp.json
.vscode/mcp.json
.codex/config.toml
